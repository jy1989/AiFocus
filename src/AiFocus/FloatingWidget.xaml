<Window x:Class="AiFocus.FloatingWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AiFocus"
        Title="{x:Static local:Loc.WidgetTitle}" SizeToContent="WidthAndHeight"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        Background="{StaticResource Paper}" Foreground="{StaticResource Ink}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave">
    <!-- Stays out of the way: a dot and a count; resting the mouse on it opens the summary and list. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="0" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Border BorderBrush="#D5DFF0" BorderThickness="1">
        <StackPanel>
            <Grid x:Name="Capsule" Height="34" Background="Transparent" Cursor="Hand"
                  MouseLeftButtonDown="Capsule_MouseLeftButtonDown" MouseMove="Capsule_MouseMove" MouseLeftButtonUp="Capsule_MouseLeftButtonUp" ToolTip="{x:Static local:Loc.WidgetTip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="AppIcon" Width="22" Height="22" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#A9B6CE" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <!-- Filled in code: "N 个待回复 [icons]  ·  N 个运行中 [icons]". -->
                <StackPanel Grid.Column="1" x:Name="Summary" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True"
                            Margin="0,0,12,0" Visibility="Collapsed"/>
                <TextBlock Grid.Column="1" x:Name="CountText" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,1" Visibility="Collapsed"/>
                <Grid.ContextMenu>
                    <ContextMenu FontSize="14">
                        <MenuItem Header="{x:Static local:Loc.MenuOpenPanel}" Click="OpenPanel_Click"/>
                        <MenuItem Header="{x:Static local:Loc.MenuNext}" Click="Next_Click"/>
                        <MenuItem Header="{x:Static local:Loc.MenuBack}" Click="Back_Click"/>
                        <Separator/>
                        <MenuItem Header="{x:Static local:Loc.MenuHideWidget}" Click="Hide_Click"/>
                    </ContextMenu>
                </Grid.ContextMenu>
            </Grid>
            <ItemsControl x:Name="ActiveList" MinWidth="360" MaxWidth="430" Visibility="Collapsed" Margin="6,0,6,6">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Row" Background="Transparent" CornerRadius="7" Cursor="Hand" Padding="0,6"
                                MouseLeftButtonUp="Row_MouseLeftButtonUp" ToolTip="{Binding ToolTipText}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{Binding AccentBrush}" CornerRadius="2" Margin="0,2"/>
                                <ContentControl Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource SessionIcon}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False"/>
                                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding DisplayTitle}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding WidgetMeta}" FontSize="12" Foreground="{StaticResource InkMuted}"
                                               TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                    <!-- One-line brief of the AI's last reply: decide without switching windows. -->
                                    <TextBlock Text="{Binding Brief}" Visibility="{Binding BriefVisibility}" FontSize="12.5"
                                               Foreground="{StaticResource InkSoft}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#E4EDFC"/>
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
