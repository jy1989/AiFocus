<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 SDK target: native toast notifications (clicking one may bring a window to the front). -->
    <TargetFramework>net9.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AiFocus</AssemblyName>
    <!-- Published without the runtime; roll forward so a newer installed .NET also runs it. -->
    <RollForward>Major</RollForward>
    <SelfContained>false</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- DPI is declared in app.manifest for WPF; the WinForms-only suggestion does not apply. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>
  <ItemGroup>
    <!-- Builds the browser bridge with the app and puts it next to AiFocus.exe (dll + apphost + runtimeconfig),
         where NativeHost registers it at startup. -->
    <ProjectReference Include="..\AiFocus.Bridge\AiFocus.Bridge.csproj" />
  </ItemGroup>
</Project>
