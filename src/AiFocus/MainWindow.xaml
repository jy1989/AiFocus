<Window x:Class="AiFocus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AiFocus"
        Title="AI Focus" Width="1080" Height="680" MinWidth="560" MinHeight="400"
        WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource Paper}"
        ShowInTaskbar="False" Topmost="True"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="15" Foreground="{StaticResource Ink}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        PreviewKeyDown="Window_PreviewKeyDown">
    <!-- No AllowsTransparency / DropShadowEffect: both force grayscale, bitmap-scaled (blurry) text.
         WindowChrome removes the frame; rounded corners and shadow come from DWM.
         Visual direction: a calm, low-stimulus focus tool. Warm paper background, borderless rows,
         colour reserved for sessions that actually need the user (待处理 / 运行中). -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="0" ResizeBorderThickness="6"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource InkSoft}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.75"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.55"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Foreground" Value="{StaticResource InkMuted}"/>
        </Style>
    </Window.Resources>
    <Border BorderBrush="#DEDBD3" BorderThickness="1">
        <Grid Margin="30,20,30,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="AI Focus" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CountsText" Foreground="{StaticResource InkMuted}" FontSize="14" VerticalAlignment="Center" Margin="14,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="↻" Style="{StaticResource GhostButton}" Click="Refresh_Click" ToolTip="{x:Static local:Loc.Refresh}"/>
                    <Button Content="⚙" Style="{StaticResource GhostButton}" Click="Settings_Click" ToolTip="{x:Static local:Loc.Settings}"/>
                    <Button Style="{StaticResource GhostButton}" Click="Close_Click" Content="✕" ToolTip="{x:Static local:Loc.Hide}"/>
                </StackPanel>
            </Grid>
            <Border Grid.Row="2" Background="#FBFAF7" BorderBrush="#E2DFD7" BorderThickness="1" CornerRadius="10" Padding="16,2">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="⌕" FontSize="22" Foreground="{StaticResource InkMuted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Grid>
                        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                                 FontSize="17" Foreground="{StaticResource Ink}" CaretBrush="{StaticResource Ink}" Padding="0,11,0,11"
                                 VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"/>
                        <TextBlock Text="{x:Static local:Loc.SearchHint}" FontSize="17" Foreground="#AAA69D" VerticalAlignment="Center"
                                   IsHitTestVisible="False" Margin="2,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
            </Border>
            <DockPanel Grid.Row="4" LastChildFill="False">
                <Button x:Name="AllButton" Content="{x:Static local:Loc.FilterAll}" Tag="all" Click="Filter_Click" Style="{StaticResource FlatButton}" Margin="0,0,4,0"/>
                <Button x:Name="AttentionButton" Content="{x:Static local:Loc.FilterAttention}" Tag="attention" Click="Filter_Click" Style="{StaticResource FlatButton}" Margin="0,0,4,0"/>
                <Button x:Name="FavoriteButton" Content="{x:Static local:Loc.FilterFavorite}" Tag="favorite" Click="Filter_Click" Style="{StaticResource FlatButton}"/>
                <Button x:Name="LayoutButton" DockPanel.Dock="Right" Content="分组" Click="Layout_Click" Style="{StaticResource FlatButton}"/>
            </DockPanel>
            <ListBox x:Name="SessionList" Grid.Row="6" BorderThickness="0" Background="Transparent" FocusVisualStyle="{x:Null}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     PreviewMouseLeftButtonUp="SessionList_PreviewMouseLeftButtonUp"
                     KeyDown="SessionList_KeyDown">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,14,0,6">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource InkMuted}"/>
                                    <TextBlock Text="{Binding ItemCount}" FontSize="13" Foreground="#AAA69D" Margin="8,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <!-- Tiles wrap into as many columns as fit; TileWidth is recomputed on resize. -->
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Width" Value="{DynamicResource TileWidth}"/>
                        <Setter Property="Margin" Value="0,0,8,8"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder" Background="#FBFAF7" CornerRadius="9">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#EDEBE5"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#E4E6E9"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid x:Name="Row" Background="Transparent" Height="74" ToolTipService.InitialShowDelay="900">
                            <Grid.ToolTip>
                                <TextBlock Text="{Binding ToolTipText}" MaxWidth="460" TextWrapping="Wrap" FontSize="13.5"/>
                            </Grid.ToolTip>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{Binding AccentBrush}" CornerRadius="2" Margin="0,10"/>
                            <ContentControl Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource SessionIcon}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False"/>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayTitle}" FontSize="15" Foreground="{StaticResource Ink}"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,6,2"/>
                                <TextBlock Text="{Binding TileMeta}" FontSize="12.5" Foreground="{StaticResource InkMuted}"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                                <!-- Latest AI reply in one line. -->
                                <TextBlock Text="{Binding Brief}" FontSize="12.5" Foreground="{StaticResource InkSoft}"
                                           TextTrimming="CharacterEllipsis" Margin="0,3,6,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Border Background="{Binding StateBackground}" CornerRadius="9" Padding="7,2"
                                        Visibility="{Binding StateVisibility}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StateText}" Foreground="{Binding StateForeground}" FontSize="12"/>
                                </Border>
                                <Button x:Name="FavoriteBtn" Content="{Binding FavoriteSymbol}" Tag="{Binding}" Click="Favorite_Click" Padding="5,2" FontSize="15"
                                        Style="{StaticResource GhostButton}" ToolTip="{x:Static local:Loc.ToggleFavorite}" Foreground="#C29A4E" Visibility="Collapsed"/>
                                <Button x:Name="AttentionBtn" Tag="{Binding}" Click="Attention_Click" Style="{StaticResource GhostButton}" Content="◷" Padding="5,2" FontSize="15"
                                        ToolTip="{x:Static local:Loc.ToggleAttention}" Visibility="Collapsed"/>
                            </StackPanel>
                            <Grid.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" FontSize="14">
                                    <MenuItem Header="{x:Static local:Loc.MenuOpen}" Click="OpenMenu_Click"/>
                                    <MenuItem Header="{x:Static local:Loc.MenuRename}" Click="RenameMenu_Click"/>
                                    <MenuItem Header="{x:Static local:Loc.MenuWorkspace}" Click="WorkspaceMenu_Click"/>
                                    <Separator/>
                                    <MenuItem Header="{x:Static local:Loc.ToggleAttention}" Click="AttentionMenu_Click"/>
                                    <MenuItem Header="{x:Static local:Loc.ToggleFavorite}" Click="FavoriteMenu_Click"/>
                                </ContextMenu>
                            </Grid.ContextMenu>
                        </Grid>
                        <!-- Row actions stay hidden until hover/selection, so the list reads as plain text. -->
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Favorite}" Value="True">
                                <Setter TargetName="FavoriteBtn" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter TargetName="FavoriteBtn" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="AttentionBtn" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter TargetName="FavoriteBtn" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="AttentionBtn" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Grid Grid.Row="7" Margin="14,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="FeedbackText" Text="{x:Static local:Loc.KeyHints}"
                           Foreground="#A29E95" FontSize="13" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="HotkeyHint" Text="Alt + Q" Foreground="#A29E95" FontSize="13"/>
            </Grid>
        </Grid>
    </Border>
</Window>
