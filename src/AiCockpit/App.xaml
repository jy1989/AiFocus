<Application x:Class="AiCockpit.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Calm, low-contrast-but-readable palette shared by the panel. -->
        <SolidColorBrush x:Key="Paper" Color="#F4F3EF"/>
        <SolidColorBrush x:Key="Ink" Color="#2E3238"/>
        <SolidColorBrush x:Key="InkSoft" Color="#555A62"/>
        <SolidColorBrush x:Key="InkMuted" Color="#8A8780"/>
        <!-- Session icon shared by the panel and the floating widget: real app icon / favicon,
             falling back to a glyph (orange ✳ for Claude). -->
        <DataTemplate x:Key="SessionIcon">
            <Grid Width="20" Height="20">
                <Image x:Name="Picture" Source="{Binding IconImage}" Width="18" Height="18"
                       RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform"/>
                <TextBlock x:Name="Glyph" Text="{Binding Icon}" Foreground="{Binding IconBrush}" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IconImage}" Value="{x:Null}">
                    <Setter TargetName="Picture" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Glyph" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Application.Resources>
</Application>
