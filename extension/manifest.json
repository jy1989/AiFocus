{
  "manifest_version": 3,
  "name": "AI Cockpit Browser Bridge",
  "version": "0.3.0",
  "description": "Local AI tab index, generation status and one-click activation for AI Cockpit.",
  "permissions": [
    "tabs",
    "storage",
    "nativeMessaging",
    "alarms",
    "scripting",
    "favicon"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["sites.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "110"
}
